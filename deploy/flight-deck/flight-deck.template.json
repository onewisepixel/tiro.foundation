{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TIRO Flight Deck 0.2.1 production foundation (NOT DEPLOYED; requires founder authorization). Dedicated operator identity (separate from the synthetic preservation backend), generated secrets, the scheduled worker (disabled until activated), a failure alarm, and the protective event log bucket. The operations database is NOT created here: provider and region await the founder's decision (docs/flight-deck/integrations.md).",
  "Parameters": {
    "PublicOrigin": {
      "Type": "String",
      "Description": "The https origin Flight Deck is served from, e.g. https://tiro.foundation",
      "AllowedPattern": "^https://[a-z0-9.-]+$"
    },
    "CognitoDomainPrefix": {
      "Type": "String",
      "Description": "Prefix for the Cognito managed login domain, e.g. tiro-ops",
      "AllowedPattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "WorkerScheduleState": {
      "Type": "String",
      "Description": "The worker schedule stays DISABLED until the console gate is recorded and the founder enables it.",
      "AllowedValues": [
        "DISABLED",
        "ENABLED"
      ],
      "Default": "DISABLED"
    },
    "AlarmEmail": {
      "Type": "String",
      "Description": "Optional address for worker-failure alarms (confirmation email required).",
      "Default": ""
    },
    "EscalationEmail": {
      "Type": "String",
      "Description": "Optional second address (the founder's escalation) for the same alarms and budget alerts. Confirmation email required.",
      "Default": ""
    },
    "AwsMonthlyBudgetUsd": {
      "Type": "Number",
      "Description": "AWS share of the staging planning ceiling. Alerts at 50% and 100% of actual spend and 100% of forecast. Alerts only: AWS does not stop spending.",
      "Default": 15,
      "MinValue": 1,
      "MaxValue": 75
    },
    "VercelTeamSlug": {
      "Type": "String",
      "Description": "Vercel team slug. With VercelProjectName, creates an IAM role that only that project's chosen environment can assume through Vercel OIDC (Global issuer mode). Empty: no role.",
      "Default": "",
      "AllowedPattern": "^[a-z0-9-]{0,48}$"
    },
    "VercelProjectName": {
      "Type": "String",
      "Description": "The dedicated Vercel staging project (never the public site's project).",
      "Default": "",
      "AllowedPattern": "^[a-z0-9._-]{0,100}$"
    },
    "VercelEnvironment": {
      "Type": "String",
      "Description": "The only Vercel environment allowed to assume the role.",
      "Default": "production",
      "AllowedValues": [
        "production",
        "preview"
      ]
    },
    "VercelBypassSecretArn": {
      "Type": "String",
      "Description": "Optional. ARN of an EXISTING Secrets Manager secret (plain-text value) holding the Vercel 'Protection Bypass for Automation' secret. When set, both EventBridge connections also send x-vercel-protection-bypass, alongside their bearer tokens. The value is read at deploy time through a dynamic reference and stored only in EventBridge's own connection secret; it never appears in the template, parameters, or outputs. Empty: no extra header.",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws:secretsmanager:[a-z0-9-]+:\\d{12}:secret:[A-Za-z0-9/_+=.@-]+$"
    },
    "VercelBypassSecretVersionId": {
      "Type": "String",
      "Description": "Optional, with VercelBypassSecretArn. The Secrets Manager version ID (not the value) to send. CloudFormation re-reads a secret only when this reference changes, so a rotation is: put the new value, then update the stack with the new version ID. Empty: the current (AWSCURRENT) version, read when the connections are created or changed.",
      "Default": "",
      "AllowedPattern": "^$|^[0-9A-Za-z-]{32,64}$"
    },
    "ProtectiveRetentionDays": {
      "Type": "Number",
      "Description": "Object Lock (governance) retention for every protective log object version. Must exceed the longest database backup or point-in-time window. Events are not expired automatically (the event at the database head must always exist); they hold only keyed hashes, opaque ids and codes. Provisional: 35 days for a 14-day PITR window.",
      "Default": 35,
      "MinValue": 15,
      "MaxValue": 400
    }
  },
  "Conditions": {
    "HasAlarmEmail": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlarmEmail"
            },
            ""
          ]
        }
      ]
    },
    "HasEscalationEmail": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "EscalationEmail"
            },
            ""
          ]
        }
      ]
    },
    "UseVercel": {
      "Fn::And": [
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "VercelTeamSlug"
                },
                ""
              ]
            }
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "VercelProjectName"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "CreateBudget": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::Region"
            },
            "af-south-1"
          ]
        }
      ]
    },
    "HasBypassSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "VercelBypassSecretArn"
            },
            ""
          ]
        }
      ]
    },
    "HasBypassSecretVersion": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "VercelBypassSecretVersionId"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "OperatorPool": {
      "Type": "AWS::Cognito::UserPool",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "UserPoolName": "tiro-flight-deck-operators",
        "DeletionProtection": "ACTIVE",
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "MfaConfiguration": "ON",
        "EnabledMfas": [
          "SOFTWARE_TOKEN_MFA"
        ],
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 14,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": false,
            "TemporaryPasswordValidityDays": 2
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "UserAttributeUpdateSettings": {
          "AttributesRequireVerificationBeforeUpdate": [
            "email"
          ]
        }
      }
    },
    "OperatorGroup": {
      "Type": "AWS::Cognito::UserPoolGroup",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "GroupName": "flight-deck",
        "Description": "Membership is required to sign in; Flight Deck's own operator table decides the role."
      }
    },
    "OperatorDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "Domain": {
          "Ref": "CognitoDomainPrefix"
        }
      }
    },
    "ConsoleClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "ClientName": "flight-deck-console",
        "GenerateSecret": true,
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "email",
          "profile"
        ],
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "CallbackURLs": [
          {
            "Fn::Sub": "${PublicOrigin}/flight-deck/auth/callback"
          }
        ],
        "LogoutURLs": [
          {
            "Fn::Sub": "${PublicOrigin}/flight-deck/signed-out"
          }
        ],
        "ExplicitAuthFlows": [
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "IdTokenValidity": 60,
        "AccessTokenValidity": 60,
        "RefreshTokenValidity": 1,
        "TokenValidityUnits": {
          "IdToken": "minutes",
          "AccessToken": "minutes",
          "RefreshToken": "days"
        }
      }
    },
    "EmailHashPepper": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "tiro/flight-deck/email-hash-pepper",
        "Description": "Keys the email hashes used for suppression and deduplication. Never stored with the data. Losing it breaks suppression matching: retain.",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true
        }
      }
    },
    "SessionSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "tiro/flight-deck/session-secret",
        "Description": "Signs the sign-in transaction cookie and derives form-token and rate-limit keys.",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true
        }
      }
    },
    "WorkerToken": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "tiro/flight-deck/worker-token",
        "Description": "Bearer token the scheduler presents to /flight-deck/internal/worker.",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true
        }
      }
    },
    "MonitorToken": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "tiro/flight-deck/monitor-token",
        "Description": "Bearer token an uptime monitor presents to /flight-deck/internal/status.",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true
        }
      }
    },
    "WorkerConnection": {
      "Type": "AWS::Events::Connection",
      "Properties": {
        "Description": "Authorizes the worker schedule to call Flight Deck.",
        "AuthorizationType": "API_KEY",
        "AuthParameters": {
          "ApiKeyAuthParameters": {
            "ApiKeyName": "Authorization",
            "ApiKeyValue": {
              "Fn::Sub": "Bearer {{resolve:secretsmanager:${WorkerToken}}}"
            }
          },
          "InvocationHttpParameters": {
            "Fn::If": [
              "HasBypassSecret",
              {
                "HeaderParameters": [
                  {
                    "Key": "x-vercel-protection-bypass",
                    "Value": {
                      "Fn::If": [
                        "HasBypassSecretVersion",
                        {
                          "Fn::Sub": "{{resolve:secretsmanager:${VercelBypassSecretArn}:SecretString:::${VercelBypassSecretVersionId}}}"
                        },
                        {
                          "Fn::Sub": "{{resolve:secretsmanager:${VercelBypassSecretArn}}}"
                        }
                      ]
                    },
                    "IsValueSecret": true
                  }
                ]
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        }
      }
    },
    "WorkerDestination": {
      "Type": "AWS::Events::ApiDestination",
      "Properties": {
        "ConnectionArn": {
          "Fn::GetAtt": [
            "WorkerConnection",
            "Arn"
          ]
        },
        "InvocationEndpoint": {
          "Fn::Sub": "${PublicOrigin}/flight-deck/internal/worker"
        },
        "HttpMethod": "POST",
        "InvocationRateLimitPerSecond": 1
      }
    },
    "WorkerInvokeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "invoke-flight-deck-worker",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "events:InvokeApiDestination",
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "WorkerDestination",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "StatusDestination",
                        "Arn"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerSchedule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Runs one Flight Deck worker tick every five minutes. Idempotent and single-runner.",
        "ScheduleExpression": "rate(5 minutes)",
        "State": {
          "Ref": "WorkerScheduleState"
        },
        "Targets": [
          {
            "Id": "flight-deck-worker",
            "Arn": {
              "Fn::GetAtt": [
                "WorkerDestination",
                "Arn"
              ]
            },
            "RoleArn": {
              "Fn::GetAtt": [
                "WorkerInvokeRole",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumRetryAttempts": 2,
              "MaximumEventAgeInSeconds": 240
            }
          }
        ]
      }
    },
    "StatusConnection": {
      "Type": "AWS::Events::Connection",
      "Properties": {
        "Description": "Authorizes the status monitor to read Flight Deck's status endpoint (counts and codes only).",
        "AuthorizationType": "API_KEY",
        "AuthParameters": {
          "ApiKeyAuthParameters": {
            "ApiKeyName": "Authorization",
            "ApiKeyValue": {
              "Fn::Sub": "Bearer {{resolve:secretsmanager:${MonitorToken}}}"
            }
          },
          "InvocationHttpParameters": {
            "Fn::If": [
              "HasBypassSecret",
              {
                "HeaderParameters": [
                  {
                    "Key": "x-vercel-protection-bypass",
                    "Value": {
                      "Fn::If": [
                        "HasBypassSecretVersion",
                        {
                          "Fn::Sub": "{{resolve:secretsmanager:${VercelBypassSecretArn}:SecretString:::${VercelBypassSecretVersionId}}}"
                        },
                        {
                          "Fn::Sub": "{{resolve:secretsmanager:${VercelBypassSecretArn}}}"
                        }
                      ]
                    },
                    "IsValueSecret": true
                  }
                ]
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        }
      }
    },
    "StatusDestination": {
      "Type": "AWS::Events::ApiDestination",
      "Properties": {
        "ConnectionArn": {
          "Fn::GetAtt": [
            "StatusConnection",
            "Arn"
          ]
        },
        "InvocationEndpoint": {
          "Fn::Sub": "${PublicOrigin}/flight-deck/internal/status"
        },
        "HttpMethod": "GET",
        "InvocationRateLimitPerSecond": 1
      }
    },
    "StatusMonitor": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Every 15 minutes, reads Flight Deck's status. It answers 503 when something needs a person: a stale or failing worker, a recovery lock, an unreachable protective log, overdue cases. With no retries, each 503 is one failed invocation, which raises the alarm.",
        "ScheduleExpression": "rate(15 minutes)",
        "State": {
          "Ref": "WorkerScheduleState"
        },
        "Targets": [
          {
            "Id": "flight-deck-status",
            "Arn": {
              "Fn::GetAtt": [
                "StatusDestination",
                "Arn"
              ]
            },
            "RoleArn": {
              "Fn::GetAtt": [
                "WorkerInvokeRole",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumRetryAttempts": 0,
              "MaximumEventAgeInSeconds": 60
            }
          }
        ]
      }
    },
    "AlarmTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "tiro-flight-deck-alarms"
      }
    },
    "AlarmSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "HasAlarmEmail",
      "Properties": {
        "TopicArn": {
          "Ref": "AlarmTopic"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlarmEmail"
        }
      }
    },
    "EscalationSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "HasEscalationEmail",
      "Properties": {
        "TopicArn": {
          "Ref": "AlarmTopic"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "EscalationEmail"
        }
      }
    },
    "WorkerFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Flight Deck worker invocations are failing (non-2xx from /flight-deck/internal/worker).",
        "Namespace": "AWS/Events",
        "MetricName": "FailedInvocations",
        "Dimensions": [
          {
            "Name": "RuleName",
            "Value": {
              "Ref": "WorkerSchedule"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 900,
        "EvaluationPeriods": 1,
        "Threshold": 2,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "StatusAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Flight Deck needs a person: its status endpoint did not answer 200 (see /flight-deck/health or the recovery page).",
        "Namespace": "AWS/Events",
        "MetricName": "FailedInvocations",
        "Dimensions": [
          {
            "Name": "RuleName",
            "Value": {
              "Ref": "StatusMonitor"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 900,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "CostBudget": {
      "Type": "AWS::Budgets::Budget",
      "Condition": "CreateBudget",
      "Metadata": {
        "Note": "Budgets cannot be created by CloudFormation in af-south-1; create the budget in the Billing console there."
      },
      "Properties": {
        "Budget": {
          "BudgetName": "tiro-flight-deck-staging-aws",
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY",
          "BudgetLimit": {
            "Amount": {
              "Ref": "AwsMonthlyBudgetUsd"
            },
            "Unit": "USD"
          }
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 50,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "Fn::If": [
                  "HasAlarmEmail",
                  {
                    "SubscriptionType": "EMAIL",
                    "Address": {
                      "Ref": "AlarmEmail"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              },
              {
                "Fn::If": [
                  "HasEscalationEmail",
                  {
                    "SubscriptionType": "EMAIL",
                    "Address": {
                      "Ref": "EscalationEmail"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "Fn::If": [
                  "HasAlarmEmail",
                  {
                    "SubscriptionType": "EMAIL",
                    "Address": {
                      "Ref": "AlarmEmail"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              },
              {
                "Fn::If": [
                  "HasEscalationEmail",
                  {
                    "SubscriptionType": "EMAIL",
                    "Address": {
                      "Ref": "EscalationEmail"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "FORECASTED",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "Fn::If": [
                  "HasAlarmEmail",
                  {
                    "SubscriptionType": "EMAIL",
                    "Address": {
                      "Ref": "AlarmEmail"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              },
              {
                "Fn::If": [
                  "HasEscalationEmail",
                  {
                    "SubscriptionType": "EMAIL",
                    "Address": {
                      "Ref": "EscalationEmail"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "ProtectiveLogBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ObjectLockEnabled": true,
        "ObjectLockConfiguration": {
          "ObjectLockEnabled": "Enabled",
          "Rule": {
            "DefaultRetention": {
              "Mode": "GOVERNANCE",
              "Days": {
                "Ref": "ProtectiveRetentionDays"
              }
            }
          }
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              },
              "BucketKeyEnabled": true
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-superseded-checkpoint-versions",
              "Status": "Enabled",
              "Prefix": "flight-deck/checkpoints/",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": {
                  "Ref": "ProtectiveRetentionDays"
                }
              }
            }
          ]
        }
      }
    },
    "ProtectiveLogBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ProtectiveLogBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ProtectiveLogBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ProtectiveLogBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "DenyGovernanceBypass",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:BypassGovernanceRetention",
              "Resource": {
                "Fn::Sub": "${ProtectiveLogBucket.Arn}/*"
              }
            }
          ]
        }
      }
    },
    "FlightDeckAppPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Attach to the identity the Flight Deck app runs as. Write-once access to the protective log; no delete, no retention changes.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AppendAndReadEvents",
              "Effect": "Allow",
              "Action": [
                "s3:PutObject",
                "s3:GetObject"
              ],
              "Resource": {
                "Fn::Sub": "${ProtectiveLogBucket.Arn}/flight-deck/*"
              }
            },
            {
              "Sid": "ListLog",
              "Effect": "Allow",
              "Action": "s3:ListBucket",
              "Resource": {
                "Fn::GetAtt": [
                  "ProtectiveLogBucket",
                  "Arn"
                ]
              },
              "Condition": {
                "StringLike": {
                  "s3:prefix": [
                    "flight-deck/*"
                  ]
                }
              }
            },
            {
              "Sid": "ReadSecrets",
              "Effect": "Allow",
              "Action": "secretsmanager:GetSecretValue",
              "Resource": [
                {
                  "Ref": "EmailHashPepper"
                },
                {
                  "Ref": "SessionSecret"
                },
                {
                  "Ref": "WorkerToken"
                },
                {
                  "Ref": "MonitorToken"
                }
              ]
            }
          ]
        }
      }
    },
    "ProtectiveLogReadOnlyPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Attach to a restore-drill copy of Flight Deck, or to an auditor. Reads the protective log (enough to verify and replay it) but cannot add to it, so a drill can never write events that production would later replay.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ReadEvents",
              "Effect": "Allow",
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${ProtectiveLogBucket.Arn}/flight-deck/*"
              }
            },
            {
              "Sid": "ListLog",
              "Effect": "Allow",
              "Action": "s3:ListBucket",
              "Resource": {
                "Fn::GetAtt": [
                  "ProtectiveLogBucket",
                  "Arn"
                ]
              },
              "Condition": {
                "StringLike": {
                  "s3:prefix": [
                    "flight-deck/*"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "VercelOidcProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "UseVercel",
      "Properties": {
        "Url": "https://oidc.vercel.com",
        "ClientIdList": [
          {
            "Fn::Sub": "https://vercel.com/${VercelTeamSlug}"
          }
        ]
      }
    },
    "VercelAppRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "UseVercel",
      "Properties": {
        "Description": "Assumed only by the named Vercel project and environment, through Vercel OIDC. Appends to and reads the protective log; nothing else.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "VercelOidcProvider"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "oidc.vercel.com:aud": {
                    "Fn::Sub": "https://vercel.com/${VercelTeamSlug}"
                  },
                  "oidc.vercel.com:sub": {
                    "Fn::Sub": "owner:${VercelTeamSlug}:project:${VercelProjectName}:environment:${VercelEnvironment}"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "protective-log-append-read",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AppendAndReadEvents",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ProtectiveLogBucket.Arn}/flight-deck/*"
                  }
                },
                {
                  "Sid": "ListLog",
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "ProtectiveLogBucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "flight-deck/*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "CognitoRegion": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "CognitoUserPoolId": {
      "Value": {
        "Ref": "OperatorPool"
      }
    },
    "CognitoClientId": {
      "Value": {
        "Ref": "ConsoleClient"
      }
    },
    "CognitoDomain": {
      "Value": {
        "Fn::Sub": "https://${CognitoDomainPrefix}.auth.${AWS::Region}.amazoncognito.com"
      }
    },
    "SecretNames": {
      "Value": "tiro/flight-deck/email-hash-pepper, session-secret, worker-token, monitor-token (client secret: read from the Cognito app client)"
    },
    "ProtectiveBucketName": {
      "Value": {
        "Ref": "ProtectiveLogBucket"
      }
    },
    "AppPolicyArn": {
      "Value": {
        "Ref": "FlightDeckAppPolicy"
      }
    },
    "ProtectiveLogReadOnlyPolicyArn": {
      "Description": "Read-only access to the protective log, for restore drills and audits.",
      "Value": {
        "Ref": "ProtectiveLogReadOnlyPolicy"
      }
    },
    "VercelAppRoleArn": {
      "Condition": "UseVercel",
      "Description": "Set as FLIGHT_DECK_AWS_ROLE_ARN in the Vercel staging project only.",
      "Value": {
        "Fn::GetAtt": [
          "VercelAppRole",
          "Arn"
        ]
      }
    }
  }
}
