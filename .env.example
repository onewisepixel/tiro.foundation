# Flight Deck environment variables. PLACEHOLDERS ONLY: no value here is a
# credential, and none should ever be committed with one. Production values
# come from a secret manager (deploy/flight-deck/flight-deck.template.json
# generates them), injected by the host; never from a file in the repo.
#
# Every Flight Deck switch defaults to OFF. Unset is the safe state.
# For local development use `npm run dev:flight-deck` (add `-- --pg` for a
# local PostgreSQL); it sets the local-demo values for that process only.
#
# Check a production configuration without printing any value:
#   npm run flight-deck:admin -- check-config

# --- Mode ------------------------------------------------------------------
# "local-demo": synthetic data and test identities, loopback only, refused in
#   any production build or on a hosting platform.
# "production": exists only when EVERY production setting below is valid,
#   and even then opens nothing until a founder approves the "console" gate
#   at /flight-deck/gates after a fresh MFA sign-in.
FLIGHT_DECK_MODE=
# "production" (default): opens only a database marked real.
# "staging": the synthetic staging deployment (docs/flight-deck/staging-setup.md):
#   opens only a database marked synthetic, never opens the public form, and
#   asks search engines not to index the site.
FLIGHT_DECK_DEPLOYMENT=

# --- Channel flags ------------------------------------------------------------
# The public form also needs, in production, a recorded "public-form" gate
# and a privacy notice that is no longer a draft: the flag alone opens nothing.
FLIGHT_DECK_PUBLIC_FORM_ENABLED=false
# Local demo only (dry-run outbox). In production email and social stay
# disabled whatever these say: no live provider is implemented, by decision.
FLIGHT_DECK_OUTBOUND_EMAIL_ENABLED=false
FLIGHT_DECK_SOCIAL_PUBLISHING_ENABLED=false
FLIGHT_DECK_BACKGROUND_JOBS_ENABLED=false

# --- Production: operations database (provider and region not yet chosen) ---
# Must require verified TLS: ...?sslmode=verify-full
FLIGHT_DECK_DATABASE_URL=<postgresql://fd_app:...@host:5432/flightdeck?sslmode=verify-full>
# The provider's CA bundle (PEM), if not in the system trust store.
FLIGHT_DECK_DATABASE_CA_PEM=<provider CA PEM, optional>

# --- Production: secrets (each at least 32 random characters, all different) --
FLIGHT_DECK_EMAIL_HASH_PEPPER=<from secret manager; never stored with the data; retain>
FLIGHT_DECK_SESSION_SECRET=<from secret manager>
FLIGHT_DECK_WORKER_TOKEN=<from secret manager; also used by the scheduler>
FLIGHT_DECK_MONITOR_TOKEN=<from secret manager; also used by the uptime monitor>

# --- Production: operator identity (dedicated Cognito pool, MFA required) ---
FLIGHT_DECK_COGNITO_REGION=<e.g. eu-west-2>
FLIGHT_DECK_COGNITO_USER_POOL_ID=<region_PoolId>
FLIGHT_DECK_COGNITO_CLIENT_ID=<app client id>
FLIGHT_DECK_COGNITO_CLIENT_SECRET=<app client secret, from Cognito>
FLIGHT_DECK_COGNITO_DOMAIN=<https://prefix.auth.region.amazoncognito.com>
FLIGHT_DECK_COGNITO_REQUIRED_GROUP=flight-deck
FLIGHT_DECK_PUBLIC_ORIGIN=<https://the-public-host>

# --- Production: protective event log (separate S3 bucket, Object Lock) -------
# From the template's ProtectiveBucketName output. Opt-outs, erasures, lifts,
# operator changes and gate approvals are written here before they commit;
# production refuses to start without it. The app's role needs the
# template's AppPolicyArn (put/get/list under the prefix; no delete).
FLIGHT_DECK_PROTECTIVE_BUCKET=<bucket name>
FLIGHT_DECK_PROTECTIVE_REGION=<e.g. eu-west-2>
# Optional; default "flight-deck/" (the app policy is scoped to it).
FLIGHT_DECK_PROTECTIVE_PREFIX=
# Test endpoints only (https, or http on loopback). Leave unset for AWS.
FLIGHT_DECK_PROTECTIVE_ENDPOINT=
# On Vercel: the template's VercelAppRoleArn output. Credentials then come from
# Vercel OIDC federation (one hour, that role only); no AWS key is stored.
# Elsewhere leave unset: the default AWS credential chain is used.
FLIGHT_DECK_AWS_ROLE_ARN=

# --- Multi-instance hosting -----------------------------------------------------
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<required when more than one instance serves the site>

# --- Local demo only ----------------------------------------------------------
FLIGHT_DECK_LOCAL_STORE_PATH=

# There is intentionally NO archive-intake variable. Real collection is out
# of scope (docs/flight-deck/collection-readiness-future.md).
