# Flight Deck 0.1 environment variables. PLACEHOLDERS ONLY: no value here
# is a credential, and none should ever be committed with one.
#
# Every Flight Deck switch defaults to OFF. Unset is the safe state.
# For local development, prefer `npm run dev:flight-deck`, which sets the
# local-demo values for that process only and writes nothing to disk here.

# "local-demo" enables synthetic fixtures and test identities. It is
# refused when NODE_ENV=production (every `next build`/`next start`), when a
# hosting-platform marker is present, and for any non-loopback Host. There
# is no production mode in 0.1.
FLIGHT_DECK_MODE=

# Channel flags. Effective only in local demo, where "true" selects the
# dry-run outbox (files under .flight-deck/outbox), never a network provider.
FLIGHT_DECK_PUBLIC_FORM_ENABLED=false
FLIGHT_DECK_OUTBOUND_EMAIL_ENABLED=false
FLIGHT_DECK_SOCIAL_PUBLISHING_ENABLED=false
FLIGHT_DECK_BACKGROUND_JOBS_ENABLED=false

# Optional override of the local synthetic store location.
FLIGHT_DECK_LOCAL_STORE_PATH=

# There is intentionally NO archive-intake variable. Real collection is out
# of scope for Flight Deck 0.1 (docs/flight-deck/collection-readiness-future.md).

# --- Reserved for a future, founder-approved production configuration ---
# Not read by any code in 0.1. Listed so the shape of the decision is visible
# (docs/flight-deck/integrations.md). Values belong in a secret manager.
# FLIGHT_DECK_IDP_ISSUER=<identity provider issuer URL>
# FLIGHT_DECK_IDP_CLIENT_ID=<client id>
# FLIGHT_DECK_DATABASE_URL=<operations database connection, secret manager only>
# FLIGHT_DECK_EMAIL_PROVIDER=<provider name>
# FLIGHT_DECK_EMAIL_API_KEY=<secret manager only>
# FLIGHT_DECK_EMAIL_HASH_PEPPER=<secret manager only>
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<required for multi-instance hosting>
